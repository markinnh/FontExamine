public static class <#= a #>GlyphTable
{
	<#= enumStatement #>
	<#= regularDictionary #>
	<#= filledDictionary #>
}
// MAUI does not support MarkupExtension with generic type parameters, so we cannot implement IMarkupExtension<string> directly. Instead, we can use the ProvideValue method to return a string value.
[ContentProperty(nameof(Glyph))]
public class <#= a #>MarkupExtension:IMarkupExtension<string>
{
	public <#= a #>GlyphTable.<#= a #>Glyphs Glyph { get; set; }= <#= a #>GlyphTable.<#= a #>Glyphs.<#= firstGlyphName #>;
	public bool IsFilled { get; set; } = false;
	public string ProvideValue(IServiceProvider serviceProvider)
	{
		return IsFilled ? <#= a #>GlyphTable.FilledGlyphToUnicodeMap[Glyph] : <#= a #>GlyphTable.RegularGlyphToUnicodeMap[Glyph];
	}
	public object ProvideValue(IServiceProvider serviceProvider)
	{
		return IsFilled ? <#= a #>GlyphTable.FilledGlyphToUnicodeMap[Glyph] : <#= a #>GlyphTable.RegularGlyphToUnicodeMap[Glyph];
	}
}
