<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TestWinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TestWinUI3"
    xmlns:markup="using:TestWinUI3.Markup"
    xmlns:vm="using:TestWinUI3.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TestWinUI3">
    
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel >
        <Button
            Content="{x:Bind markup:SegoeFluentIconHelper.GetGlyphUnicode(markup:SegoeFluentGlyph.AddFolder)}"  Style="{StaticResource MyButtonStyle}" Command="{x:Bind ViewModel.ButtonClickedCommand}" CommandParameter="{x:Bind markup:SegoeFluentIconHelper.GetGlyphUnicode(markup:SegoeFluentGlyph.AddFolder)}" />
        <Button
            Content="{x:Bind markup:SegoeFluentIconHelper.GetGlyphUnicode(markup:SegoeFluentGlyph.Add)}"  Style="{StaticResource MyButtonStyle}" Command="{x:Bind ViewModel.ButtonClickedCommand}" CommandParameter="{x:Bind markup:SegoeFluentIconHelper.GetGlyphUnicode(markup:SegoeFluentGlyph.Add)}" />
        <Button
            Content="{x:Bind markup:SegoeFluentIconHelper.GetGlyphUnicode(markup:SegoeFluentGlyph.Delete)}"  Style="{StaticResource MyButtonStyle}" Command="{x:Bind ViewModel.ButtonClickedCommand}" CommandParameter="{x:Bind markup:SegoeFluentIconHelper.GetGlyphUnicode(markup:SegoeFluentGlyph.Delete)}" />
        </StackPanel>
        <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.ClickNotifications}" ><ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClickNotification">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{x:Bind markup:SegoeFluentIconHelper.GetGlyphUnicode(markup:SegoeFluentGlyph.Event)}" FontSize="14" VerticalAlignment="Center" Foreground="Yellow" FontFamily="Segoe Fluent Icons"/>
                        <TextBlock Text="{x:Bind Message}" FontSize="14" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons"/>
                        <TextBlock Text="{x:Bind Timestamp}" FontSize="12" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
