<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System" #>
<#@ assembly name="$(NuGetPackageRoot)Newtonsoft.Json\13.0.1\lib\net45\Newtonsoft.Json.dll" #>
<#@ import namespace="Newtonsoft.Json"#>
<#@ import namespace="Newtonsoft.Json.Linq"#>
<#@ output extension=".cs" #>

using System.Collections.Generic;
<#


WriteLine("// This file is generated by GlyphGlue.tt. Do not edit it directly.");
var location = Path.Combine(Path.GetDirectoryName(Host.TemplateFile), "GlueGlyph.json");
WriteLine($"// Loading symbol definitions from {location}");
var symbolDefinitionsText = File.ReadAllText(location);
var symbolDefinitions = JObject.Parse(symbolDefinitionsText);
// currently we only support one definition, so we take the first one and report how many glyphs it defines
var activeDefinition = symbolDefinitions["Name"];
//var firstDefinition = symbolDefinitions["Definitions"].FirstOrDefault();
symbolName= symbolDefinitions["SymbolName"].ToString();
fontUsed= symbolDefinitions["UsedFor"]?.ToString()??"Segoe";
WriteLine($"// Project Name: {symbolDefinitions["Name"]}");
WriteLine($"// {symbolDefinitions["DefinedGlyphs"]?.Count()} defined glyphs");
WriteLine($"// Last Generated: {DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")}");
// output the enums
WriteLine("namespace TestWinUI3.Markup;");
WriteLine($"		public enum {fontUsed}Glyph {{");
for(int i = 0; i < symbolDefinitions["DefinedGlyphs"]?.Count(); i++)
{
	var name = symbolDefinitions["DefinedGlyphs"][i]["GlyphName"].ToString();
	var unicode = symbolDefinitions["DefinedGlyphs"][i]["GlyphId"].ToString();
	var nextchar= i + 1 < symbolDefinitions["DefinedGlyphs"]?.Count() ? "," : "";
	if(i == 0)
	{
		firstGlyphName = name;
	}
	WriteLine($"		    {name} = {unicode}{nextchar}");
}
WriteLine("			} // end enum");
WriteLine($"    public static class {symbolName}IconTable {{");
WriteLine($"			public static Dictionary<{fontUsed}Glyph, string> GlyphToUnicodeMap = new Dictionary<{fontUsed}Glyph, string>() {{");
for(int i = 0; i < symbolDefinitions["DefinedGlyphs"]?.Count(); i++)
{
	var name = symbolDefinitions["DefinedGlyphs"][i]["GlyphName"].ToString();
	var unicode = symbolDefinitions["DefinedGlyphs"][i]["GlyphId"].ToString();
	var nextchar= i + 1 < symbolDefinitions["DefinedGlyphs"]?.Count() ? "," : "};";
	WriteLine($"		    {{ {fontUsed}Glyph.{name}, char.ConvertFromUtf32({unicode}) }}{nextchar}");
}
WriteLine($"	}}  // end class {symbolName}IconTable");
//WriteLine("}");
#>


public class <#= fontUsed #>IconHelper
{
	public <#= fontUsed #>Glyph Glyph { get; set; }= <#= fontUsed #>Glyph.<#= firstGlyphName #>;
	public static string GetGlyphUnicode(<#= fontUsed #>Glyph glyph)
    {
        return <#= symbolName #>IconTable.GlyphToUnicodeMap[glyph];
    }
}

<#+  
	string symbolName = "";
	string fontUsed = "";
	string firstGlyphName = "";
#>

